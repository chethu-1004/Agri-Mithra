DATABASE_URL=postgresql+psycopg://agrinetra:URL_ENCODED_PASSWORD@127.0.0.1:5433/agrinetra
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
PREDICTION_THRESHOLD=0.60
MODEL_PATH=ml_models/efficientnetb0_agrinetra_v1.keras
CLASS_LABELS_PATH=ml_models/class_labels_v1.json
MODEL_METADATA_PATH=ml_models/model_metadata_v1.json
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
USER_FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500
ADMIN_FRONTEND_URL=http://127.0.0.1:5501,http://localhost:5501
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
# Legacy OpenAI compatibility route only; /api/ai/chat uses local Ollama.
CHATBOT_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# Legacy aliases remain supported for an existing deployment.
CHATBOT_API_KEY=
CHATBOT_BASE_URL=
CHATBOT_MODEL=
CHATBOT_TIMEOUT_SECONDS=30
CHATBOT_REQUESTS_PER_MINUTE=20
CHATBOT_HISTORY_MESSAGES=12
# Local Ollama powers /api/ai/chat. Install Ollama and pull this model before use.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=90
# Optional live web search for questions about current information.
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=12
AI_MAX_REQUEST_BYTES=32768
# The OpenAI values below remain available for the legacy /api/chat route.
AGRI_RAG_ENABLED=false
AGRI_RAG_DOCUMENTS_DIR=knowledge/agriculture
AGRI_RAG_INDEX_PATH=knowledge/agriculture_index.json
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
STORAGE_PROVIDER=local
STORAGE_BUCKET=
MODEL_VERSION=v1
